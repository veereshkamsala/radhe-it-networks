---
import { whatsappNumber, whatsappTopics } from "../data/contact";
---

<aside class="whatsapp-widget fixed bottom-5 right-5 z-40 flex flex-col items-end gap-3 sm:bottom-7 sm:right-7">
  <section
    id="whatsapp-panel"
    class="hidden w-[min(20rem,calc(100vw-2.5rem))] overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-slate-950/20"
    role="dialog"
    aria-labelledby="whatsapp-title"
    aria-hidden="true"
  >
    <div class="bg-[#075e54] p-5 text-white">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-white/75">Radhe IT Networks</p>
          <h2 id="whatsapp-title" class="mt-1 font-['Space_Grotesk'] text-lg font-semibold">How can we help?</h2>
        </div>
        <button
          class="whatsapp-close grid h-8 w-8 shrink-0 place-items-center rounded-full text-xl leading-none text-white/80 transition hover:bg-white/10 hover:text-white"
          type="button"
          aria-label="Close WhatsApp chat options"
        >×</button>
      </div>
      <p class="mt-2 text-sm leading-6 text-white/80">Choose a topic to start a WhatsApp conversation with our team.</p>
    </div>
    <ul class="grid gap-2 p-4">
      {whatsappTopics.map((topic) => {
        const message = `Hello Radhe IT Networks, I’d like to discuss ${topic.toLowerCase()}.`;
        const href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
        return (
          <li>
            <a
              class="whatsapp-topic flex items-center justify-between gap-3 rounded-lg border border-slate-200 px-3 py-3 text-sm font-medium text-slate-700 transition hover:border-teal-300 hover:bg-teal-50 hover:text-slate-950"
              href={href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{topic}</span><span class="text-teal-700" aria-hidden="true">↗</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <button
    class="whatsapp-toggle grid h-14 w-14 place-items-center rounded-full border-4 border-white bg-[#20bd68] text-white shadow-lg shadow-slate-950/20 transition hover:-translate-y-1 hover:bg-[#18a95b]"
    type="button"
    aria-label="Open WhatsApp chat options"
    aria-expanded="false"
    aria-controls="whatsapp-panel"
  >
    <svg class="h-7 w-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .1 5.4.1 12c0 2.1.6 4.2 1.7 6L0 24l6.2-1.6a12 12 0 0 0 5.9 1.5h.1c6.6 0 12-5.4 12-12 0-3.2-1.3-6.2-3.7-8.4ZM12.1 22a10 10 0 0 1-5.1-1.4l-.4-.2-3.7 1 1-3.6-.3-.4A9.9 9.9 0 0 1 2 12C2 6.5 6.5 2 12.1 2c2.6 0 5.1 1 7 2.9a9.9 9.9 0 0 1 2.9 7c0 5.6-4.5 10.1-9.9 10.1Zm5.5-7.6c-.3-.1-1.6-.8-1.9-.9-.3-.1-.5-.1-.7.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.4.1-.6l.5-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.5-.5-.4-.7-.4H8c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.3s1 2.6 1.1 2.8c.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.6-.7 1.8-1.3.2-.6.2-1.1.2-1.3-.1-.2-.3-.3-.6-.4Z" />
    </svg>
  </button>
</aside>

<script>
  import "../scripts/whatsapp-widget";
</script>
