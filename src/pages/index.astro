---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import { whatsappNumber } from "../data/contact";
import { services } from "../data/services";

const serviceIcons = {
  network: "M4 7h6v6H4zM14 4h6v6h-6zM14 14h6v6h-6zM7 13v4h7m-4-7h4",
  factory: "M3 20V9l6 3V8l6 4V5h6v15H3Zm4-3h1m4 0h1m4 0h1",
  shield: "M12 3 4.5 6v5.3c0 4.6 3.2 8.8 7.5 9.7 4.3-.9 7.5-5.1 7.5-9.7V6L12 3Zm-3 9 2 2 4-4",
  signal: "M4 18v-3m5 3V9m5 9V5m5 13v-7",
};
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section id="home" class="relative isolate overflow-hidden bg-[#071827] text-white">
      <div class="absolute -right-36 -top-44 -z-10 h-[34rem] w-[34rem] rounded-full border border-teal-300/10"></div>
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1.05fr_.95fr] lg:gap-16 lg:py-32">
        <div class="hero-copy">
          <p class="mb-6 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.2em] text-teal-300">
            <span class="h-2 w-2 rounded-full bg-teal-300"></span>
            Networks built for what’s next
          </p>
          <h1 class="font-['Space_Grotesk'] text-5xl font-semibold leading-[1.04] tracking-[-.06em] sm:text-6xl lg:text-7xl">
            Infrastructure<br />for a <span class="text-teal-300">connected</span><br />world.
          </h1>
          <p class="mt-7 max-w-xl text-base leading-8 text-slate-300 sm:text-lg">
            Enterprise networks, industrial connectivity, and managed services engineered for the places where reliability matters most.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-5">
            <a class="rounded-md bg-teal-400 px-6 py-4 text-sm font-bold text-slate-950 transition hover:bg-teal-300" href="#services">
              Explore our capabilities <span aria-hidden="true">↗</span>
            </a>
            <a class="text-sm font-semibold text-slate-200 transition hover:text-teal-300" href="#contact">
              Start a conversation <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="mt-12 flex flex-wrap gap-x-7 gap-y-3 border-t border-white/10 pt-6 text-xs font-semibold uppercase tracking-[.12em] text-slate-400">
            <span>Enterprise networks</span><span>Industrial IoT</span><span>Managed operations</span>
          </div>
        </div>

        <div class="hero-illustration relative mx-auto flex aspect-square w-full max-w-[500px] items-center justify-center">
          <div class="network-ring absolute inset-[8%] rounded-full border border-teal-300/10"></div>
          <div class="network-ring network-ring-delay absolute inset-[20%] rounded-full border border-teal-300/15"></div>
          <div class="network-ring network-ring-delay-more absolute inset-[32%] rounded-full border border-dashed border-teal-300/20"></div>
          <div class="network-orbit absolute inset-[10%]" aria-hidden="true">
            <div class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2">
              <span class="network-orbit-label rounded-lg border border-white/10 bg-[#0d2435] px-4 py-3 text-center text-[10px] font-bold tracking-widest text-slate-300">CAMPUS LAN</span>
            </div>
            <div class="absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2">
              <span class="network-orbit-label rounded-lg border border-white/10 bg-[#0d2435] px-4 py-3 text-center text-[10px] font-bold tracking-widest text-slate-300">INDUSTRIAL IoT</span>
            </div>
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2">
              <span class="network-orbit-label rounded-lg border border-white/10 bg-[#0d2435] px-4 py-3 text-center text-[10px] font-bold tracking-widest text-slate-300">SECURITY</span>
            </div>
            <div class="absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2">
              <span class="network-orbit-label rounded-lg border border-white/10 bg-[#0d2435] px-4 py-3 text-center text-[10px] font-bold tracking-widest text-slate-300">TELECOM</span>
            </div>
          </div>
          <div class="network-core relative grid h-36 w-36 place-items-center rounded-full border border-teal-200/50 bg-gradient-to-br from-teal-300/20 to-slate-900 shadow-[0_0_90px_rgba(45,212,191,.15)] sm:h-44 sm:w-44">
            <div class="absolute inset-3 rounded-full border border-teal-200/15"></div>
            <svg class="h-14 w-14 text-teal-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3 4.5 6v5.3c0 4.6 3.2 8.8 7.5 9.7 4.3-.9 7.5-5.1 7.5-9.7V6L12 3Zm-3 9 2 2 4-4" />
            </svg>
          </div>
          <div class="absolute bottom-[1%] text-[10px] font-bold uppercase tracking-[.22em] text-slate-500">Connected with confidence</div>
        </div>
      </div>
    </section>

    <section class="bg-white px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold uppercase tracking-[.2em] text-teal-700">Radhe IT Networks</p>
        <h2 class="mt-4 font-['Space_Grotesk'] text-3xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
          Reliable technology, from the core to the edge.
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-600">
          From corporate campuses and hospitals to factories and telecom environments, we design, deploy, and support the infrastructure that keeps people and operations connected.
        </p>
      </div>
    </section>

    <section id="services" class="scroll-mt-20 bg-slate-50 px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div>
            <p class="text-xs font-bold uppercase tracking-[.2em] text-teal-700">What we do</p>
            <h2 class="mt-4 max-w-2xl font-['Space_Grotesk'] text-3xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
              Connected systems.<br class="hidden sm:block" /> Thoughtful execution.
            </h2>
          </div>
          <p class="max-w-md text-sm leading-7 text-slate-600">
            Bring architecture, deployment, security, and ongoing operations together with one experienced technology partner.
          </p>
        </div>
        <div class="grid gap-5 lg:grid-cols-2">
          {services.map((service, index) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
              <div class="flex items-start justify-between gap-4">
                <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-teal-50 text-teal-700">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={serviceIcons[service.icon]} />
                  </svg>
                </div>
                <span class="font-['Space_Grotesk'] text-sm font-semibold tracking-widest text-slate-300">0{index + 1}</span>
              </div>
              <h3 class="mt-6 font-['Space_Grotesk'] text-xl font-semibold leading-snug text-slate-900 sm:text-2xl">{service.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{service.description}</p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {service.items.map((item) => (
                  <li class="flex gap-2 text-sm leading-6 text-slate-700">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="scroll-mt-20 bg-[#071827] px-5 py-20 text-white sm:px-8 sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.2em] text-teal-300">Where we work</p>
          <h2 class="mt-4 font-['Space_Grotesk'] text-3xl font-semibold tracking-tight sm:text-5xl">Built for critical environments.</h2>
          <p class="mt-5 max-w-lg text-sm leading-7 text-slate-300">
            Regional expertise and dependable delivery for organizations that need secure, resilient connectivity.
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {[
            "Corporate offices and campuses",
            "Educational institutions",
            "Private hospitals",
            "Commercial complexes",
            "Manufacturing plants",
            "Warehouses and logistics hubs",
            "Telecom operators and ISPs",
            "Solar, wind, and utility sites",
          ].map((sector) => (
            <div class="rounded-xl border border-white/10 bg-white/[.04] px-5 py-4 text-sm font-medium text-slate-200">
              <span class="mr-3 text-teal-300" aria-hidden="true">↗</span>{sector}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="digital" class="scroll-mt-20 bg-white px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-end">
          <div>
            <p class="text-xs font-bold uppercase tracking-[.2em] text-teal-700">Digital services</p>
            <h2 class="mt-4 font-['Space_Grotesk'] text-3xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
              More ways to move your business forward.
            </h2>
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            {[
              ["Web development", "Business websites designed around your goals."],
              ["Mobile apps", "Mobile app experiences for your customers and teams."],
              ["Digital marketing", "Digital campaigns to help grow your online reach."],
            ].map(([title, description]) => (
              <article class="rounded-xl border border-slate-200 bg-slate-50 p-5">
                <h3 class="font-['Space_Grotesk'] text-lg font-semibold text-slate-900">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-20 bg-teal-50 px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto flex max-w-7xl flex-col justify-between gap-8 rounded-3xl bg-[#071827] p-8 text-white sm:p-12 lg:flex-row lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.2em] text-teal-300">Start a conversation</p>
          <h2 class="mt-4 max-w-2xl font-['Space_Grotesk'] text-3xl font-semibold tracking-tight sm:text-5xl">
            Let’s build what your network needs next.
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-7 text-slate-300">
            Tell us about your site, project, or operations requirements. We’ll be glad to hear from you.
          </p>
        </div>
        <div class="flex shrink-0 flex-col items-start gap-4">
          <a class="rounded-md bg-teal-400 px-6 py-4 text-sm font-bold text-slate-950 transition hover:bg-teal-300" href="mailto:info@radhenetworksolutions.com">
            Email our team <span aria-hidden="true">↗</span>
          </a>
          <a class="text-sm font-medium text-slate-200 transition hover:text-teal-300" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">
            WhatsApp: +91 93980 19398
          </a>
        </div>
      </div>
      <div class="mx-auto mt-8 max-w-7xl text-sm text-slate-600">
        <address class="not-italic">Sadhguru Apartments, Sri Nagar Colony, Anantapur, Andhra Pradesh, India</address>
      </div>
    </section>
  </main>
  <footer class="bg-[#04111c] px-5 py-7 text-sm text-slate-400 sm:px-8">
    <div class="mx-auto flex max-w-7xl flex-col justify-between gap-3 sm:flex-row sm:items-center">
      <span>© {new Date().getFullYear()} Radhe IT Networks. All rights reserved.</span>
      <a class="transition hover:text-white" href="https://www.radheitnetworks.com" target="_blank" rel="noopener noreferrer">radheitnetworks.com <span aria-hidden="true">↗</span></a>
    </div>
  </footer>
  <WhatsAppWidget />
</BaseLayout>
